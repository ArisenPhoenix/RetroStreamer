<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.ArisenPhoenix.ArchStreamer</id>
  <name>ArchStreamer</name>
  <summary>LAN RetroArch / emulator streaming</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <description>
    <p>
      ArchStreamer joins a LAN host to play streamed RetroArch or Switch (Yuzu)
      sessions with local controllers. The Host tab can start a native host_runner
      via flatpak-spawn when this app runs as a Flatpak (gamescope/uinput stay on
      the host OS). Artwork stays on each machine; Settings configures Steam art
      and the native host_runner path.
    </p>
  </description>
  <launchable type="desktop-id">io.github.ArisenPhoenix.ArchStreamer.desktop</launchable>
  <url type="homepage">https://github.com/ArisenPhoenix/RetroStreamer</url>
  <categories>
    <category>Game</category>
    <category>Emulator</category>
  </categories>
  <provides>
    <binary>archstreamer_gui</binary>
  </provides>
  <releases>
    <release version="0.1.0" date="2026-07-21"/>
  </releases>
  <content_rating type="oars-1.1"/>
</component>
